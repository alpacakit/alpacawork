{
  "name": "@alpacawork/core",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./ui-language": {
      "types": "./dist/ui-language.d.ts",
      "default": "./dist/ui-language.js"
    },
    "./package-version": {
      "types": "./dist/package-version.d.ts",
      "default": "./dist/package-version.js"
    },
    "./installed-skills": {
      "types": "./dist/installed-skills.d.ts",
      "default": "./dist/installed-skills.js"
    },
    "./host-measurement": {
      "types": "./dist/platform/host-measurement.d.ts",
      "default": "./dist/platform/host-measurement.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codes": {
      "types": "./dist/codes.d.ts",
      "default": "./dist/codes.js"
    },
    "./issues": {
      "types": "./dist/issues.d.ts",
      "default": "./dist/issues.js"
    },
    "./reasons": {
      "types": "./dist/reasons.d.ts",
      "default": "./dist/reasons.js"
    },
    "./selection": {
      "types": "./dist/selection.d.ts",
      "default": "./dist/selection.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@alpacakit/channels": "0.2.0-beta.5",
    "koffi": "3.3.1",
    "zod": "4.3.6"
  }
}
