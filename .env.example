# How many tests run in parallel on this machine. Set it only when the
# defaults are too heavy or too light here.
#
# Where to put it: copy this file to .env (git ignores it).
#   - .env in a worktree applies to that worktree.
#   - .env in the main checkout applies to every worktree made from it.
# Which value wins: the environment variable, then the worktree's .env, then the
# main checkout's .env, then the default below.
# To see the values in effect and where each came from:
#   node scripts/testing/queue.ts settings

# Workers for one test stage (web, node and e2e). A number, or auto.
# auto picks from the free CPUs and memory when the stage starts, up to
# ALPACAWORK_TEST_AUTO_MAX_WORKERS, and at most 2 on battery power.
# Default: auto
#ALPACAWORK_TEST_WORKERS=auto

# Test stages allowed to run at once across all worktrees. A number, or auto.
# auto starts another stage while free CPUs and memory cover it.
# Default: 2
#ALPACAWORK_TEST_MAX_PARALLEL=2

# Upper limit on the workers auto gives one stage.
# Default: 8
#ALPACAWORK_TEST_AUTO_MAX_WORKERS=8

# Memory (MiB) kept free for other programs.
# Default: a quarter of total memory when ALPACAWORK_TEST_WORKERS or
# ALPACAWORK_TEST_MAX_PARALLEL is auto; otherwise 0.
#ALPACAWORK_TEST_RESERVE_MIB=

# CPUs kept free for other programs when ALPACAWORK_TEST_WORKERS or
# ALPACAWORK_TEST_MAX_PARALLEL is auto.
# Default: a quarter of the cores
#ALPACAWORK_TEST_RESERVE_CPUS=
