#!/bin/sh
# Refuses pushing to main: changes reach main only through a pull request with a squash merge.
# Install once per clone; it then covers every worktree:
#   cp scripts/git-hooks/pre-push "$(git rev-parse --git-common-dir)/hooks/pre-push"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: main is updated only by merging a pull request. Push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
