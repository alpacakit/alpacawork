{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@alpacawork/backend/test-dist/*": ["../backend/src/*"] }
  },
  "include": ["src", "tests", "dev", "vite.config.ts", "vite.diagnostic.config.ts", "vitest.config.ts"]
}
